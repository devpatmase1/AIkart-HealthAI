# ==========================================
# Healthcare Agent Orchestrator - Environment
# ==========================================

# Active Scenario ('default' is standard tumor board)
SCENARIO=default

# Backend Hostname for local development
BACKEND_APP_HOSTNAME=localhost:8000

# ==========================================
# LLM Configuration (Option A: Groq API)
# ==========================================
# GROQ_API_KEY=gsk_...
# OPENAI_MODEL_ID=openai/gpt-oss-120b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ==========================================
# LLM Configuration (Option B: Direct OpenAI)
# ==========================================
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL_ID=gpt-4o

# ==========================================
# LLM Configuration (Option C: Azure OpenAI)
# ==========================================
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_DEPLOYMENT_NAME_REASONING_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# ==========================================
# Local Storage & Agent Service Settings
# ==========================================
# Set to 'local' for offline patient data (Patient 4 sample bundled)
APP_BLOB_STORAGE_ENDPOINT=local

# Empty dictionaries for local standalone execution without Teams bot registration
BOT_IDS={}
HLS_MODEL_ENDPOINTS={}

# Excluded agents if you want to skip any specific agent (comma separated)
# EXCLUDED_AGENTS=magentic,graph_rag
